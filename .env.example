# Culprit agent configuration.
#
# Copy this file to `.env` and edit it; `docker compose` reads `.env`
# automatically, and `docker run --env-file .env` uses the same file. On
# Portainer / TrueNAS SCALE, set these as the stack's environment variables.

# Required — the culprit host node URL (the dashboard the agent reports to).
CULPRIT_HOST=http://192.168.1.5:8787

# Required — the agent token: host dashboard -> Nodes -> "Generate token".
CULPRIT_TOKEN=web-01.replace-with-your-secret

# Optional.
# CULPRIT_INTERVAL=1        # seconds between reports (default 1)
# CULPRIT_INSECURE=1        # accept the host's self-signed TLS certificate
# CULPRIT_LOG_LEVEL=info    # debug | info | warning | error
